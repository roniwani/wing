    waveSpeed = 2.5,  -- 上下動の速度
    baseAmplitude = 2,  -- 基本の上下動の振幅
    distanceMultiplier = 0.4,  -- 距離による振幅の増加率
    phaseOffset = 0.3,  -- 隣の花火との位相差（波のように）
