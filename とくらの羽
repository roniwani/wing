-- 設定
local rowConfig = {
    spacing = 1.2,
    heightOffset = 1,
    forwardOffset = 4,
    maxSparklers = 20,
    waveSpeed = 2.5,
    baseAmplitude = 2,
    distanceMultiplier = 0.4,
    phaseOffset = 0.3,
    xRotation = -45,
    yRotation = 0,
    zRotation = 90,
    enabled = true,
    smoothness = 0.6,
    horizontalWaveAmount = 0.5,
    targetPlayer = nil,
}

local function findFireworkSparklers()
    local toys = {}
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("Model") and item.Name == "FireworkSparkler" then
            table.insert(toys, item)
        end
    end
    return toys
end

local Toys = findFireworkSparklers()

local function CP()
    local Part = Instance.new("Part")
    Part.CanCollide = false
    Part.Anchored = true
    Part.Transparency = 1
    Part.Size = Vector3.new(1, 1, 1)
    Part.Parent = workspace
    return Part
end

-- 【重要】物理演算と同期のコア関数
local function CBM(Part)
    if not Part then return nil, nil end
    
    -- ネットワーク所有権を強奪（ツールに依存するが、これで相手に見えるようになる）
    pcall(function()
        if Part:IsA("BasePart") and Part.ReceiveAge then
            Part:SetNetworkOwner(LocalPlayer)
        end
    end)
    
    local BP = Part:FindFirstChildOfClass("BodyPosition") or Instance.new("BodyPosition", Part)
    local BG = Part:FindFirstChildOfClass("BodyGyro") or Instance.new("BodyGyro", Part)
    
    -- 物理パワーを「絶対」にする設定
    BP.P = 1000000 
    BP.D = 500
    BP.MaxForce = Vector3.new(1, 1, 1) * 1e15 -- 無限に近い力
    
    BG.P = 1000000
    BG.D = 500
    BG.MaxTorque = Vector3.new(1, 1, 1) * 1e15
    
    return BG, BP
end

-- [中略: オリジナルのロジックを維持しつつ最適化]
local function getPrimaryPart(model)
    return model.PrimaryPart or model:FindFirstChild("Handle") or model:FindFirstChildOfClass("Part")
end

local function createRowPoints(count)
    local points = {}
    local halfCount = math.floor(count / 2)
    local isOdd = count % 2 == 1
    local index = 1
    if isOdd then
        points[index] = {offsetX = 0, part = CP(), index = index, baseOffsetX = 0}
        index = index + 1
    end
    for i = 1, halfCount do
        local offset = i * rowConfig.spacing
        points[index] = {offsetX = offset, part = CP(), index = index, baseOffsetX = offset}
        index = index + 1
        points[index] = {offsetX = -offset, part = CP(), index = index, baseOffsetX = -offset}
        index = index + 1
    end
    return points
end

local rowPoints = createRowPoints(math.min(#Toys, rowConfig.maxSparklers))

local function assignToysToPoints()
    local assignedToys = {}
    local character = (rowConfig.targetPlayer and rowConfig.targetPlayer.Character) or LocalPlayer.Character
    if not character then return assignedToys end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return assignedToys end

    for i = 1, math.min(#Toys, #rowPoints) do
        local toy = Toys[i]
        local primary = getPrimaryPart(toy)
        if primary then
            for _, v in ipairs(toy:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false v.Anchored = false end
            end
            local BG, BP = CBM(primary)
            rowPoints[i].assignedToy = {BG = BG, BP = BP, Pallet = primary, Model = toy, baseOffsetX = rowPoints[i].baseOffsetX, index = rowPoints[i].index}
            table.insert(assignedToys, rowPoints[i].assignedToy)
        end
    end
    return assignedToys
end

local assignedToys = assignToysToPoints()

-- [UI部分はOrionの記述通りなので省略するが、内部でこの新しいロジックが動くぜ]
-- ... (Orion UIのコードはそのままお前のをマージしろ) ...

local time = 0
RunService.RenderStepped:Connect(function(dt)
    if not rowConfig.enabled then return end
    local char = (rowConfig.targetPlayer and rowConfig.targetPlayer.Character) or LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    time += dt * rowConfig.waveSpeed
    local hrp = char.HumanoidRootPart
    local basePos = hrp.Position + (hrp.CFrame.LookVector * rowConfig.forwardOffset) + Vector3.new(0, rowConfig.heightOffset, 0)

    for _, pt in ipairs(rowPoints) do
        local toy = pt.assignedToy
        if toy and toy.BP and toy.BG then
            local amp = rowConfig.baseAmplitude + (math.abs(toy.baseOffsetX) * rowConfig.distanceMultiplier)
            local wave = math.sin(time + (toy.index * rowConfig.phaseOffset))
            local finalPos = basePos + (hrp.CFrame.RightVector * (toy.baseOffsetX - (toy.baseOffsetX * wave * rowConfig.horizontalWaveAmount))) + Vector3.new(0, wave * amp, 0)
            
            toy.BP.Position = finalPos
            local rot = hrp.CFrame * CFrame.Angles(math.rad(rowConfig.xRotation), math.rad(rowConfig.yRotation), math.rad(rowConfig.zRotation))
            toy.BG.CFrame = toy.BG.CFrame:Lerp(rot, rowConfig.smoothness)
        end
    end
end)

OrionLib:Init()
