    smoothness = 0.6,  -- 回転と位置の滑らかさ（0-1、高いほど滑らか）
    horizontalWaveAmount = 0.5,  -- 上下に合わせた左右の動き（内側に寄る量）
    targetPlayer = nil,  -- 対象プレイヤー（nilなら自分）
